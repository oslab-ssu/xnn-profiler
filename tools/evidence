#!/usr/bin/env python3
"""측정 결과를 장치 간에 대조한다.

같은 가중치를 서로 다른 장치에서 측정하면, 값은 세 부류로 갈린다.

  구조 불변량   가중치·장치와 무관하다. 어긋나면 키 구성이나 구간 집계가 틀린 것이다
  모델 의존     가중치로 정해진다. 같은 가중치면 일치하여야 한다
  장치 의존     장치로 정해진다. 달라지는 것이 정상이며, 그 차이가 측정의 내용이다

  tools/evidence out-cpu out-gpu
"""

from __future__ import annotations

import argparse
import json
import os
import sys

SYNC_OPS = frozenset({
    "aten::item", "aten::_local_scalar_dense", "aten::is_nonzero",
    "aten::nonzero", "aten::equal", "aten::allclose", "aten::_assert_async",
})


def load(d: str, model: str):
    p = os.path.join(d, model, "xnn-trace.json")
    if not os.path.exists(p):
        return None
    with open(p, encoding="utf-8") as f:
        return json.load(f)["xnn"]


def prof_detail(t) -> dict:
    s = next((x for x in t["sources"] if x["collector"] == "torch_profiler"), None)
    return (s or {}).get("detail", {}) or {}


def sync_fraction(t) -> float:
    hit = dur = 0.0
    for r in t["regions"]:
        ops = r.get("ops") or {}
        hit += sum(v for k, v in ops.items() if k in SYNC_OPS)
        dur += r["dur_us"]
    return hit / dur if dur else 0.0


def spike_rows(t) -> dict:
    return {sp["layer_id"]: sp for sp in t.get("spikes", [])}


def fmt(v) -> str:
    if v is None:
        return "—"
    if isinstance(v, float):
        return f"{v:,.4f}" if abs(v) < 10 else f"{v:,.1f}"
    if isinstance(v, int):
        return f"{v:,}"
    if isinstance(v, tuple):
        return " ".join(f"{a}:{b}" for a, b in v)
    return str(v)


STRUCTURAL = [
    ("실행 MAC",     lambda t: t["metrics"]["executed_macs"]),
    ("구간 수",      lambda t: len(t["regions"])),
    ("레이어·호출",  lambda t: tuple(sorted((l["layer_id"], l["calls"])
                                            for l in t["layers"]))),
    ("상태 메모리",  lambda t: t["metrics"].get("state_bytes")),
    ("타임스텝",     lambda t: t["timesteps"]),
]

MODEL_DEP = [
    ("가중치 지문",      lambda t: (t["env"].get("weights_sha256") or "—")[:16]),
    ("SynOps",           lambda t: t["metrics"].get("synops")),
    ("출력 발생 지연",   lambda t: (t["metrics"].get("output_latency") or {}).get("first_spike_step")),
    ("배치 정확도",      lambda t: t["env"].get("batch_accuracy")),
]

DEVICE_DEP = [
    ("장치",             lambda t: t["env"].get("device")),
    ("구간 시간 기준",   lambda t: t["env"].get("region_timing")),
    ("구간 시간 합(us)", lambda t: round(sum(r["dur_us"] for r in t["regions"]), 1)),
    ("귀속률",           lambda t: prof_detail(t).get("attribution_rate")),
    ("계측 비용(us)",    lambda t: prof_detail(t).get("instrument_us")),
    ("동기화 비중",      lambda t: round(sync_fraction(t), 4)),
]


def section(title, items, traces, names, check):
    print(f"  {title}")
    width = max(len(n) for n in names)
    head = "  ".join(f"{n:>{max(width, 14)}s}" for n in names)
    print(f"    {'':20s} {head}   판정")
    for label, get in items:
        vals = [get(t) for t in traces]
        same = all(v == vals[0] for v in vals)
        verdict = "" if not check else ("일치" if same else "불일치")
        cells = "  ".join(f"{fmt(v):>{max(width, 14)}s}" for v in vals)
        print(f"    {label:20s} {cells}   {verdict}")
    print()


def spikes_section(traces, names):
    keys = sorted({k for t in traces for k in spike_rows(t)})
    if not keys:
        return
    print("  모델 의존 — 스파이크 통계 (가중치가 같으면 일치하여야 한다)")
    width = max(max(len(n) for n in names), 14)
    print(f"    {'':28s} " + "  ".join(f"{n:>{width}s}" for n in names) + "   판정")
    for k in keys:
        rows = [spike_rows(t).get(k) for t in traces]
        for field, path in (("발화율", "mean_rate"), ("dead", "dead_fraction"),
                            ("saturated", "saturated_fraction"),
                            ("스파이크 수", "spikes")):
            vals = [None if r is None else r["metrics"].get(path) for r in rows]
            same = all(v == vals[0] for v in vals)
            cells = "  ".join(f"{fmt(v):>{width}s}" for v in vals)
            print(f"    {k + ' / ' + field:28s} {cells}   {'일치' if same else '불일치'}")
    print()


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("dirs", nargs="+", help="비교할 출력 디렉터리 2개 이상")
    ap.add_argument("--models", default="fcsnn,mnist_mlp,repeated_dnn_snn")
    args = ap.parse_args()

    names = [os.path.basename(d.rstrip("/\\")) for d in args.dirs]
    bad = 0
    for model in args.models.split(","):
        traces = [load(d, model) for d in args.dirs]
        if any(t is None for t in traces):
            missing = [n for n, t in zip(names, traces) if t is None]
            print(f"=== {model}: 건너뜀 (없음: {', '.join(missing)})\n")
            continue
        print("=" * 92)
        print(f"{model}")
        print()
        section("구조 불변량 — 가중치·장치와 무관하다", STRUCTURAL, traces, names, True)
        section("모델 의존 — 가중치로 정해진다", MODEL_DEP, traces, names, True)
        spikes_section(traces, names)
        section("장치 의존 — 달라지는 것이 측정의 내용이다", DEVICE_DEP, traces, names, False)

        for label, get in STRUCTURAL:
            vals = [get(t) for t in traces]
            if any(v != vals[0] for v in vals):
                print(f"  !! 구조 불변량 불일치: {label}")
                bad += 1
    if bad:
        print(f"구조 불변량 {bad}건 불일치 — 키 구성 또는 구간 집계를 확인한다")
    return 1 if bad else 0


if __name__ == "__main__":
    raise SystemExit(main())
