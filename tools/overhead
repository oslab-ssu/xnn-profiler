#!/usr/bin/env python3
"""Instrumentation cost -- how much inserting instrumentation points slows
execution down.

Inserting measurement points changes what is being observed. The conditions
below are measured repeatedly on the same input to separate the cost of the
hooks themselves, of opening and closing labels, and of the profiler.

  base      no instrumentation
  hook      hooks only (no labels, no membrane distribution)
  label     hooks + record_function labels
  mem       label + membrane distribution histogram (two kernels per neuron
            module call)
  prof      mem + a PyTorch Profiler session
  stack     prof + Python call stack recording (--with-stack)

  tools/overhead --model all --steps 10 --batch 64 --repeat 20
"""

from __future__ import annotations

import argparse
import os
import statistics
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

# When stdout is a pipe, Windows falls back to cp949 and non-ASCII symbols
# raise UnicodeEncodeError (this happens under `nsys profile`). Pin UTF-8.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")


from xnnprof.collect.torch_hooks import TorchHookCollector   # noqa: E402
from xnnprof.models import REGISTRY, build                   # noqa: E402


def timed(fn, repeat: int, device: str) -> tuple[float, float]:
    import torch
    samples = []
    for _ in range(repeat):
        if device == "cuda":
            torch.cuda.synchronize()
        t = time.perf_counter()
        fn()
        if device == "cuda":
            torch.cuda.synchronize()
        samples.append((time.perf_counter() - t) * 1e3)
    return statistics.median(samples), statistics.stdev(samples) if repeat > 1 else 0.0


def main() -> int:
    import torch

    ap = argparse.ArgumentParser()
    ap.add_argument("--model", default="all", choices=sorted(REGISTRY) + ["all"])
    ap.add_argument("--steps", type=int, default=10)
    ap.add_argument("--batch", type=int, default=64)
    ap.add_argument("--repeat", type=int, default=20)
    ap.add_argument("--device", default="cpu")
    args = ap.parse_args()

    dev = args.device
    if dev == "cuda" and not torch.cuda.is_available():
        print("cuda is unavailable -- measuring on cpu", file=sys.stderr)
        dev = "cpu"
    torch.set_num_threads(1)
    names = sorted(REGISTRY) if args.model == "all" else [args.model]

    print(f"device={dev}  batch={args.batch}  T={args.steps}  repeat={args.repeat}")
    print(f"{'model':18s} {'cond':6s} {'median(ms)':>12s} {'stdev':>9s} "
          f"{'vs base':>10s}")
    for name in names:
        torch.manual_seed(0)
        model, fkw = build(name, num_steps=args.steps)
        model = model.to(dev).eval()
        x = torch.rand(args.batch, 1, 28, 28, device=dev)

        def forward():
            with torch.no_grad():
                model(x, **fkw)

        forward()                                   # warm-up: skip lazy init
        base, base_sd = timed(forward, args.repeat, dev)
        rows = [("base", base, base_sd)]

        for tag, labels, mem in (("hook", False, False), ("label", True, False),
                                 ("mem", True, True)):
            c = TorchHookCollector(emit_labels=labels, membrane=mem)
            c.attach(model)
            m, sd = timed(forward, args.repeat, dev)
            c.detach()
            rows.append((tag, m, sd))

        from torch.profiler import ProfilerActivity, profile as tprofile
        acts = [ProfilerActivity.CPU] + ([ProfilerActivity.CUDA] if dev == "cuda" else [])

        def with_prof(stack=False):
            def run():
                c = TorchHookCollector(emit_labels=True, membrane=True)
                c.attach(model)
                with tprofile(activities=acts, profile_memory=True,
                              record_shapes=False, with_stack=stack):
                    forward()
                c.detach()
            return run

        for tag, stack in (("prof", False), ("stack", True)):
            m, sd = timed(with_prof(stack), args.repeat, dev)
            rows.append((tag, m, sd))

        for tag, m, sd in rows:
            ratio = "-" if tag == "base" else f"{m / base:>9.2f}x"
            print(f"{name:18s} {tag:6s} {m:12.3f} {sd:9.3f} {ratio:>10s}")
        print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
