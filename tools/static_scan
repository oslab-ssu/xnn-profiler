#!/usr/bin/env python3
"""Measure whether static source inspection can find instrumentation points.

The current runtime approach walks `named_modules()` and only sees calls registered as
modules in the model tree. Functional ops in forward (`F.linear`), tensor methods
(`x.flatten(1)`), and operators (`+`) are not modules and are not caught.

This tool parses the model source as an AST and
  1) classifies call sites inside forward by kind, and
  2) traces attribute -> module type back from assignments in `__init__`,
     to see how far types can be determined statically.
The difference from the set found by the runtime walk is the set of missed points.

Given a trace, statically found points are matched against the regions actually
produced, and uninstrumented points are reported with source line numbers. Insertion
is done at runtime; static inspection verifies its coverage.

  tools/static_scan --file xnnprof/models/__init__.py
  tools/static_scan --trace out/fcsnn/xnn-trace.json --model FcSnn
"""

from __future__ import annotations

import argparse
import ast
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO)

# When output is piped, Windows falls back to cp949 and non-ASCII symbols raise
# UnicodeEncodeError (e.g. under nsys profile). Force UTF-8.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")


MODULE_CALL = "module call"
FUNCTIONAL = "functional"
TENSOR_METHOD = "tensor method"
OPERATOR = "operator"
OTHER = "other call"

# Only types that produce MACs or hold state are instrumented (same as torch_hooks.targets)
TARGET_TYPES = {"Linear", "Conv2d", "Conv1d", "Conv3d"}
SNN_TYPES = {"Leaky", "Synaptic", "Alpha", "Lapicque", "RLeaky", "RSynaptic"}
CONTAINERS = {"Sequential", "ModuleList", "ModuleDict"}


def attr_types(cls: ast.ClassDef) -> dict[str, str]:
    """Collect attribute -> type from `self.x = nn.Y(...)` assignments in `__init__`.

    If the arguments of `nn.Sequential(...)` are literal constructors, children are
    expanded as `dnn1.0`. Only literal assignments are understood; modules built from
    config, attached with `setattr`, or created in loops cannot be typed without running.
    """
    out: dict[str, str] = {}
    for fn in cls.body:
        if not isinstance(fn, ast.FunctionDef) or fn.name != "__init__":
            continue
        for node in ast.walk(fn):
            if not isinstance(node, ast.Assign) or not isinstance(node.value, ast.Call):
                continue
            f = node.value.func
            tname = f.attr if isinstance(f, ast.Attribute) else (
                f.id if isinstance(f, ast.Name) else None)
            if tname is None:
                continue
            for t in node.targets:
                if not (isinstance(t, ast.Attribute) and isinstance(t.value, ast.Name)
                        and t.value.id == "self"):
                    continue
                out[t.attr] = tname
                if tname not in CONTAINERS:
                    continue
                for i, arg in enumerate(node.value.args):   # expand children
                    if not isinstance(arg, ast.Call):
                        continue
                    g = arg.func
                    child = g.attr if isinstance(g, ast.Attribute) else (
                        g.id if isinstance(g, ast.Name) else None)
                    if child:
                        out[f"{t.attr}.{i}"] = child
    return out


def classify(node: ast.AST, types: dict[str, str]) -> tuple[str, str, str]:
    """(kind, text, statically determined type)"""
    if isinstance(node, ast.BinOp):
        op = type(node.op).__name__
        return OPERATOR, {"Add": "+", "Mult": "*", "Sub": "-"}.get(op, op), ""
    if not isinstance(node, ast.Call):
        return "", "", ""
    f = node.func
    if isinstance(f, ast.Attribute) and isinstance(f.value, ast.Name):
        if f.value.id == "self":
            return MODULE_CALL, f"self.{f.attr}(...)", types.get(f.attr, "")
        if f.value.id in ("F", "functional"):
            return FUNCTIONAL, f"F.{f.attr}(...)", ""
        if f.value.id == "torch":
            return FUNCTIONAL, f"torch.{f.attr}(...)", ""
    if isinstance(f, ast.Attribute):
        return TENSOR_METHOD, f".{f.attr}(...)", ""
    if isinstance(f, ast.Name):
        return OTHER, f"{f.id}(...)", ""
    return OTHER, "<call>", ""


def trace_layers(path: str) -> set[str]:
    import json
    with open(path, encoding="utf-8") as f:
        d = json.load(f)
    d = d.get("xnn", d)
    return {r["layer_id"] for r in d.get("regions", [])}


def covered(attr: str, layers: set[str]) -> str:
    """Whether an attribute name appears as a layer_id in the trace.

    Numeric names are normalized by the collector to `dnn1.0:Conv2d`, and containers
    appear through their children. Both cases are matched.
    """
    if attr in layers:
        return attr
    hits = sorted(l for l in layers
                  if l.startswith(attr + ".") or l.startswith(attr + ":"))
    return ", ".join(hits)


def scan(path: str, layers: set[str] | None = None, only: str = "") -> None:
    tree = ast.parse(open(path, encoding="utf-8").read(), filename=path)
    classes = [n for n in ast.walk(tree) if isinstance(n, ast.ClassDef)]
    if not classes:
        print(f"{path}: no nn.Module definitions")
        return

    for cls in classes:
        if only and cls.name != only:
            continue
        fwd = next((f for f in cls.body
                    if isinstance(f, ast.FunctionDef) and f.name == "forward"), None)
        if fwd is None:
            continue
        types = attr_types(cls)
        print("=" * 84)
        print(f"class {cls.name}   {len(types)} attributes typed from __init__")
        for k, v in types.items():
            mark = ("instrumented" if v in TARGET_TYPES | SNN_TYPES else
                    "container (children expanded)" if v in CONTAINERS else "not a target")
            print(f"    self.{k:14s} = {v:12s} {mark}")

        rows, counts = [], {}
        for node in ast.walk(fwd):
            kind, text, tname = classify(node, types)
            if not kind:
                continue
            counts[kind] = counts.get(kind, 0) + 1
            rows.append((node.lineno, kind, text, tname))

        print(f"\n  {len(rows)} call sites inside forward")
        print(f"  {'line':>4s}  {'kind':12s} {'text':24s} {'static type':14s} runtime walk")
        for lineno, kind, text, tname in sorted(rows):
            if kind == MODULE_CALL:
                if tname in CONTAINERS:
                    caught = "children only (index names)"
                elif tname in TARGET_TYPES | SNN_TYPES:
                    caught = "caught"
                elif tname:
                    caught = "not a target"
                else:
                    caught = "type unknown"
            else:
                caught = "missed"
            print(f"  {lineno:4d}  {kind:12s} {text:24s} {tname or '-':14s} {caught}")

        if layers is not None:
            print("  trace check: were statically found points actually instrumented?")
            seen, gaps = set(), []
            for lineno, kind, text, tname in sorted(rows):
                if kind == MODULE_CALL:
                    attr = text[len("self."):-len("(...)")]
                    kids = ({k: v for k, v in types.items()
                             if k.startswith(attr + ".")}
                            if tname in CONTAINERS else {attr: tname})
                    for name, ctype in sorted(kids.items()) or [(attr, tname)]:
                        if name in layers or covered(name, layers):
                            hit = covered(name, layers)
                            seen.update(hit.split(", "))
                            print(f"    {lineno:4d}  self.{name:14s} {ctype:12s} "
                                  f"-> regions {hit}")
                        else:
                            why = ("instrumentation missing" if ctype in TARGET_TYPES | SNN_TYPES
                                   else "excluded by registration rule")
                            gaps.append((lineno, f"self.{name}", ctype or "type unknown", why))
                else:
                    gaps.append((lineno, text, kind, "not a module; structurally impossible"))
            for lineno, what, why, how in sorted(gaps):
                print(f"    {lineno:4d}  {what:20s} {why:14s} {how}")
            extra = layers - seen
            if extra:
                print(f"    {len(extra)} regions not in source: {', '.join(sorted(extra))}")
            print(f"    instrumented points {len(seen)} / uninstrumented {len(gaps)}")
            print()

        missed = sum(v for k, v in counts.items() if k != MODULE_CALL)
        print(f"\n  summary  module calls {counts.get(MODULE_CALL, 0)} / "
              f"non-module points {missed} "
              f"(functional {counts.get(FUNCTIONAL, 0)}, "
              f"tensor methods {counts.get(TENSOR_METHOD, 0)}, "
              f"operators {counts.get(OPERATOR, 0)}, "
              f"other {counts.get(OTHER, 0)})")
        print()


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--file", default=os.path.join(REPO, "xnnprof", "models", "__init__.py"))
    ap.add_argument("--trace", default="", help="xnn-trace.json to check against")
    ap.add_argument("--model", default="", help="inspect a single class name only")
    args = ap.parse_args()
    scan(args.file, trace_layers(args.trace) if args.trace else None, args.model)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
