#!/usr/bin/env python3
"""xnnprof — DNN·SNN·혼합 모델을 하나의 축에서 측정하고 통일 포맷으로 기록한다.

  tools/xnnprof --model repeated_dnn_snn --steps 10 --batch 64 --train 12000
  tools/xnnprof --model all --steps 10 --batch 64 --train 6000
  tools/xnnprof --model all --data ../profiler-verification/data

GPU에서는 NVTX 라벨이 자동으로 켜진다. Nsight Systems까지 한 번에 묶으려면

  tools/xnnprof --model fcsnn --device cuda --nsys

측정과 병합을 두 명령으로 나눠도 된다. 리포트는 프로세스가 끝난 뒤에 쓰이므로
측정하는 자기 자신은 그 파일을 읽을 수 없다 — `--nsys`는 그래서 자기를 nsys로
다시 띄우고, 자식이 끝나 리포트가 생긴 뒤에 병합한다.

  nsys profile -t cuda,nvtx -o out/fcsnn/nsys \
      python tools/xnnprof --model fcsnn --device cuda --out out
  tools/nsys_merge out/fcsnn/xnn-trace.json out/fcsnn/nsys.nsys-rep
"""

from __future__ import annotations

import argparse
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO)

# 출력이 파이프로 가면 Windows에서 인코딩이 cp949로 떨어져 한글·기호에서
# UnicodeEncodeError가 난다 (nsys profile 아래에서 실행할 때). UTF-8로 고정한다.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")


from xnnprof.emit import trace_json                 # noqa: E402
from xnnprof.weights import load_or_train           # noqa: E402
from xnnprof.models import REGISTRY, build          # noqa: E402
from xnnprof.report import summary                  # noqa: E402
from xnnprof.run import profile                      # noqa: E402


REENTRY = "XNN_UNDER_NSYS"      # 자식에게 '이미 nsys 아래'라고 알리는 표시


def run_under_nsys(args, argv: list[str]) -> int:
    """자기 자신을 `nsys profile`로 다시 띄우고, 끝난 뒤 리포트를 병합한다.

    리포트는 감싼 프로세스가 종료된 뒤에 쓰인다. 측정하는 쪽이 자기 리포트를
    읽는 것은 원리적으로 불가능하므로, 바깥에 한 겹을 두고 자식이 끝난 다음에
    병합한다. 사용자에게는 한 명령이다.
    """
    import subprocess
    from xnnprof.collect.nsys import NsysCollector, nsys_bin
    from xnnprof.emit import trace_json
    from xnnprof.emit.full_trace import extract
    from xnnprof.schema import Trace

    if args.model == "all":
        print("--nsys 는 모델 하나에만 쓴다. NVTX 범위 이름이 모델 사이에서 "
              "겹쳐(lif1@t0 등) 어느 모델의 커널인지 구분되지 않는다.",
              file=sys.stderr)
        return 1
    nsys = nsys_bin()
    if not nsys:
        print("nsys 를 찾지 못했다. PATH에 넣거나 환경변수 NSYS로 경로를 준다.\n"
              "  Nsight Compute 에 딸려 오는 동명의 바이너리는 리포트를 만들지 "
              "못하므로 Nsight Systems 쪽 경로를 써야 한다.", file=sys.stderr)
        return 1

    out_dir = os.path.join(args.out, args.model)
    os.makedirs(out_dir, exist_ok=True)
    report = os.path.join(out_dir, "nsys")
    if not os.path.abspath(report).isascii():
        print(f"경고: 경로에 ASCII 가 아닌 문자가 있다 — nsys 가 실패할 수 있다.\n"
              f"  {os.path.abspath(report)}\n"
              f"  Windows 라면 subst 로 ASCII 드라이브를 만들어 거기서 실행한다.",
              file=sys.stderr)

    child = [a for a in argv if a != "--nsys"]
    cmd = [nsys, "profile", "-t", "cuda,nvtx", "-o", report,
           "--force-overwrite", "true",
           sys.executable, os.path.abspath(__file__)] + child
    print(f"[1/2] nsys profile -> {report}.nsys-rep")
    rc = subprocess.run(cmd, env=dict(os.environ, **{REENTRY: "1"})).returncode
    if rc != 0:
        print(f"측정이 0이 아닌 값으로 끝났다 (rc={rc})", file=sys.stderr)

    trace_path = os.path.join(out_dir, "xnn-trace.json")
    rep = report + ".nsys-rep"
    if not os.path.exists(trace_path) or not os.path.exists(rep):
        print(f"병합할 수 없다 — 트레이스 {os.path.exists(trace_path)}, "
              f"리포트 {os.path.exists(rep)}", file=sys.stderr)
        return 1

    print(f"\n[2/2] 병합 {rep}")
    trace = Trace.load(trace_path)
    full = extract(trace_path)          # 실행 전체 트랙은 xnn 키에 없다
    src = NsysCollector(rep).collect(trace)
    trace.sources = [s for s in trace.sources if s.collector != src.collector]
    trace.sources.append(src)
    trace_json.write(trace, trace_path, full=full)
    d = src.detail or {}
    print(f"  {src.status}  NVTX 범위 {d.get('nvtx_ranges')}개 / 구간 "
          f"{d.get('matched_regions')}개에 병합  "
          f"범위 안 커널 {d.get('kernel_us_in_ranges', 0):,.1f}us "
          f"({d.get('in_range_fraction', 0):.1%})")
    print(f"\n-> {trace_path}")
    return 0 if src.status in ("captured", "partial") else 1


def default_data() -> str:
    """MNIST 기본 위치. 저장소 안에 없으면 옆의 profiler-verification/data를 본다."""
    here = os.path.join(REPO, "data")
    if os.path.isdir(os.path.join(here, "MNIST")):
        return here
    sibling = os.path.join(os.path.dirname(REPO), "profiler-verification", "data")
    if os.path.isdir(os.path.join(sibling, "MNIST")):
        return sibling
    return here


def mnist(batch: int, n: int, train: bool, root: str, raw: bool,
          download: bool = False):
    import torch
    from torchvision import datasets, transforms
    steps = [transforms.ToTensor()]
    if not raw:
        steps.append(transforms.Normalize((0.1307,), (0.3081,)))
    try:
        ds = datasets.MNIST(root, train=train, download=download,
                            transform=transforms.Compose(steps))
    except RuntimeError as e:
        raise SystemExit(
            f"MNIST를 {os.path.abspath(root)} 에서 찾지 못했다. "
            f"--data 로 위치를 지정하거나 --download 를 준다.\n  {e}")
    if n and n < len(ds):
        ds = torch.utils.data.Subset(ds, range(n))
    return torch.utils.data.DataLoader(ds, batch_size=batch, shuffle=False)


def main() -> int:
    import torch
    import torch.nn as nn

    ap = argparse.ArgumentParser()
    ap.add_argument("--model", default="repeated_dnn_snn",
                    choices=sorted(REGISTRY) + ["all"])
    ap.add_argument("--steps", type=int, default=10)
    ap.add_argument("--batch", type=int, default=64)
    ap.add_argument("--train", type=int, default=6000)
    ap.add_argument("--data", default=default_data(),
                    help="MNIST 위치. 기본값은 저장소의 data/, 없으면 "
                         "옆의 profiler-verification/data")
    ap.add_argument("--download", action="store_true",
                    help="--data 에 없으면 내려받는다")
    ap.add_argument("--raw-input", action="store_true")
    ap.add_argument("--out", default="out")
    ap.add_argument("--weights", default="",
                    help="가중치 디렉터리. 파일이 있으면 불러 쓰고 없으면 학습 후 저장한다. "
                         "장치를 바꿔 가며 같은 모델을 측정할 때 쓴다")
    ap.add_argument("--device", default="cpu",
                    help="cpu | cuda. cuda에서는 NVTX 라벨을 함께 내보낸다")
    ap.add_argument("--no-torch-profiler", action="store_true",
                    help="PyTorch Profiler 없이 hook만으로 측정한다. 연산을 여러 개 "
                         "쏘는 모듈은 op당 프로파일러 비용이 누적되므로, 레이어별 "
                         "시간을 볼 때나 nsys로 쌀 때는 끈다")
    ap.add_argument("--sync-regions", action="store_true",
                    help="GPU: 구간 경계마다 동기화해 레이어별 실제 GPU 시간을 잰다. "
                         "레이어 간 겹침이 사라지므로 합계는 실행 시간보다 길어진다")
    ap.add_argument("--cover-leaves", action="store_true",
                    help="자식이 없는 모든 모듈에 계측 지점을 삽입한다")
    ap.add_argument("--no-membrane", action="store_true",
                    help="막전위 분포를 산출하지 않는다. 뉴런 모듈 호출마다 "
                         "히스토그램 커널 2개가 추가되므로, 계측 비용을 "
                         "비교할 때 끈다")
    ap.add_argument("--no-full-trace", action="store_true",
                    help="실행 전체의 연산 계층을 얹지 않는다. 등록된 구간 밖에서 "
                         "무엇이 돌았는지가 빠지고 파일이 작아진다")
    ap.add_argument("--nsys", action="store_true",
                    help="측정을 nsys profile 로 감싸고 끝난 뒤 리포트를 구간에 "
                         "병합한다. 한 명령으로 끝남. 모델 하나에만 쓸 수 있음")
    ap.add_argument("--with-stack", action="store_true",
                    help="파이썬 호출 스택까지 기록한다. 실행 전체 트랙의 깊이가 "
                         "6에서 20단계 이상으로 늘고 파일이 3~4배가 된다. "
                         "계측 비용도 함께 늘므로 시간을 볼 때는 끈다")
    ap.add_argument("--no-op-tree", action="store_true",
                    help="구간 안의 연산자 호출 계층을 내보내지 않는다. "
                         "중첩 슬라이스가 빠지면 Flame Graph가 그려지지 않는다")
    args = ap.parse_args()

    if args.nsys and not os.environ.get(REENTRY):
        return run_under_nsys(args, sys.argv[1:])

    names = sorted(REGISTRY) if args.model == "all" else [args.model]
    dev = args.device
    if dev.startswith("cuda") and not torch.cuda.is_available():
        print("CUDA를 사용할 수 없다 — nvidia-smi와 torch.version.cuda를 확인한다",
              file=sys.stderr)
        return 1
    if dev == "cpu":
        torch.set_num_threads(1)

    for name in names:
        torch.manual_seed(0)
        model, fkw = build(name, num_steps=args.steps)
        model = model.to(dev)

        def train_once():
            opt = torch.optim.Adam(model.parameters(), lr=1e-3)
            lossf = nn.CrossEntropyLoss()
            model.train()
            for xb, yb in mnist(args.batch, args.train, True, args.data,
                                args.raw_input, args.download):
                xb, yb = xb.to(dev), yb.to(dev)
                opt.zero_grad()
                lossf(model(xb, **fkw), yb).backward()
                opt.step()

        origin, digest = load_or_train(
            model, name, args.weights, dev,
            train_once if args.train else None)
        xb, yb = next(iter(mnist(args.batch, args.batch, False, args.data,
                                 args.raw_input, args.download)))
        xb, yb = xb.to(dev), yb.to(dev)
        out_dir = os.path.join(args.out, name)
        trace = profile(model, xb, model_id=name, timesteps=args.steps,
                        batch=args.batch, out_dir=out_dir, device=dev,
                        cover_leaves=args.cover_leaves,
                        sync_regions=args.sync_regions,
                        membrane=not args.no_membrane,
                        op_tree=not args.no_op_tree,
                        full_trace=not args.no_full_trace,
                        with_stack=args.with_stack,
                        with_torch_profiler=not args.no_torch_profiler, **fkw)
        trace.env["weights"] = origin
        trace.env["weights_sha256"] = digest
        model.eval()
        with torch.no_grad():
            acc = (model(xb, **fkw).argmax(1) == yb).float().mean().item()
        trace.env["batch_accuracy"] = round(acc, 4)
        trace_json.write(trace, os.path.join(out_dir, "xnn-trace.json"),
                         full=getattr(trace, "_full", None))
        print("=" * 76)
        print(summary(trace))
        print(f"\n-> {out_dir}/xnn-trace.json  "
              f"(device {dev}, 가중치 {origin} {digest[:12]}, 배치 정확도 {acc:.1%})")
        print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
