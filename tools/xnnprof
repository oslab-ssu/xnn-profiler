#!/usr/bin/env python3
"""xnnprof: measure DNN, SNN, and hybrid models on one axis and write the unified format.

  tools/xnnprof --model repeated_dnn_snn --steps 10 --batch 64 --train 12000
  tools/xnnprof --model all --steps 10 --batch 64 --train 6000
  tools/xnnprof --model all --data ../profiler-verification/data

On GPU, NVTX labels are enabled automatically. To include Nsight Systems in one step:

  tools/xnnprof --model fcsnn --device cuda --nsys
  tools/xnnprof --model fcsnn --device cuda --ncu      # per-kernel counters

Measurement and merge can also be two commands. The report is written after the process
exits, so the measuring process itself cannot read it; `--nsys` therefore relaunches
itself under nsys and merges once the child has exited and the report exists.

  nsys profile -t cuda,nvtx -o out/fcsnn/nsys \
      python tools/xnnprof --model fcsnn --device cuda --out out
  tools/nsys_merge out/fcsnn/xnn-trace.json out/fcsnn/nsys.nsys-rep
"""

from __future__ import annotations

import argparse
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO)

# When output is piped, Windows falls back to cp949 and non-ASCII symbols raise
# UnicodeEncodeError (e.g. under nsys profile). Force UTF-8.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")


from xnnprof.emit import trace_json                 # noqa: E402
from xnnprof.weights import load_or_train           # noqa: E402
from xnnprof.models import REGISTRY, build          # noqa: E402
from xnnprof.report import summary                  # noqa: E402
from xnnprof.run import profile                      # noqa: E402


REENTRY = "XNN_WRAPPED"      # tells the child it is already running under nsys or ncu


def run_wrapped(args, argv: list[str], tool: str) -> int:
    """Relaunch this script under `nsys profile` or `ncu`, then merge the report.

    The report is written after the wrapped process exits. The measuring process cannot
    read its own report in principle, so an outer layer merges after the child exits.
    To the user it is a single command.
    """
    import subprocess
    import time
    from xnnprof.emit import trace_json
    from xnnprof.emit.full_trace import extract
    from xnnprof.schema import Trace

    if args.model == "all":
        print(f"--{tool} works with a single model only. NVTX range names overlap between "
              "models (lif1@t0 etc.), so kernels could not be told apart by model.",
              file=sys.stderr)
        return 1
    out_dir = os.path.join(args.out, args.model)
    os.makedirs(out_dir, exist_ok=True)
    report = os.path.join(out_dir, tool)
    child = [a for a in argv if a != f"--{tool}"]
    if tool == "nsys":
        from xnnprof.collect.nsys import NsysCollector, nsys_bin
        exe = nsys_bin()
        if not exe:
            print("nsys not found. Put it on PATH or set the NSYS environment variable.\n"
                  "  The same-named binary shipped with Nsight Compute cannot produce "
                  "reports; use the Nsight Systems path.", file=sys.stderr)
            return 1
        prefix = [exe, "profile", "-t", "cuda,nvtx", "-o", report,
                  "--force-overwrite", "true"]
        rep = report + ".nsys-rep"
        make = lambda: NsysCollector(rep)                   # noqa: E731
    else:
        from xnnprof.collect.ncu import NcuCollector, ncu_bin, profile_cmd
        exe = ncu_bin()
        if not exe:
            print("ncu not found. Put it on PATH or set the NCU environment variable.",
                  file=sys.stderr)
            return 1
        prefix = profile_cmd(exe, report)
        rep = report + ".ncu-rep"
        make = lambda: NcuCollector(rep)                    # noqa: E731
        if "--no-torch-profiler" not in child:
            # Both use CUPTI; the PyTorch Profiler cannot trace CUDA under ncu.
            child.append("--no-torch-profiler")
    if not os.path.abspath(report).isascii():
        print(f"warning: the path contains non-ASCII characters; {tool} may fail.\n"
              f"  {os.path.abspath(report)}\n"
              f"  On Windows, map an ASCII drive with subst and run from there.",
              file=sys.stderr)

    cmd = prefix + [sys.executable, os.path.abspath(__file__)] + child
    trace_path = os.path.join(out_dir, "xnn-trace.json")
    print(f"[1/2] {tool} -> {rep}")
    started = time.time()
    rc = subprocess.run(cmd, env=dict(os.environ, **{REENTRY: "1"})).returncode

    # Success is judged by the artifacts this run wrote, not by the exit code. On Windows
    # the child can exit with 0xC0000409 during shutdown after writing everything. File
    # mtimes are checked so leftovers from an earlier run are not mistaken for this one.
    def fresh(p: str) -> bool:
        return os.path.exists(p) and os.path.getmtime(p) >= started - 1.0

    ok_trace, ok_rep = fresh(trace_path), fresh(rep)
    if rc != 0:
        state = "all artifacts written; continuing with merge" if ok_trace and ok_rep \
            else "artifacts missing"
        print(f"measured process exit code {rc} ({rc & 0xFFFFFFFF:#010x}): {state}",
              file=sys.stderr)
    if not (ok_trace and ok_rep):
        print(f"cannot merge: trace from this run {ok_trace}, "
              f"report {ok_rep}", file=sys.stderr)
        return 1

    print(f"\n[2/2] merge {rep}")
    trace = Trace.load(trace_path)
    full = extract(trace_path)          # the full-run track is not in the xnn key
    src = make().collect(trace)
    trace.sources = [s for s in trace.sources if s.collector != src.collector]
    trace.sources.append(src)
    trace_json.write(trace, trace_path, full=full)
    d = src.detail or {}
    print(f"  {src.status}  {src.reason}  merged {d.get('nvtx_ranges')} NVTX ranges into "
          f"{d.get('matched_regions')} regions  "
          f"kernels in ranges {d.get('kernel_us_in_ranges', 0):,.1f}us")
    print(f"\n-> {trace_path}")
    return 0 if src.status in ("captured", "partial") else 1


def default_data() -> str:
    """Default MNIST location: data/ in the repo, else the sibling profiler-verification/data."""
    here = os.path.join(REPO, "data")
    if os.path.isdir(os.path.join(here, "MNIST")):
        return here
    sibling = os.path.join(os.path.dirname(REPO), "profiler-verification", "data")
    if os.path.isdir(os.path.join(sibling, "MNIST")):
        return sibling
    return here


def mnist(batch: int, n: int, train: bool, root: str, raw: bool,
          download: bool = False):
    import torch
    from torchvision import datasets, transforms
    steps = [transforms.ToTensor()]
    if not raw:
        steps.append(transforms.Normalize((0.1307,), (0.3081,)))
    try:
        ds = datasets.MNIST(root, train=train, download=download,
                            transform=transforms.Compose(steps))
    except RuntimeError as e:
        raise SystemExit(
            f"MNIST not found in {os.path.abspath(root)}. "
            f"Pass --data with its location or --download.\n  {e}")
    if n and n < len(ds):
        ds = torch.utils.data.Subset(ds, range(n))
    return torch.utils.data.DataLoader(ds, batch_size=batch, shuffle=False)


def main() -> int:
    import torch
    import torch.nn as nn

    ap = argparse.ArgumentParser()
    ap.add_argument("--model", default="repeated_dnn_snn",
                    choices=sorted(REGISTRY) + ["all"])
    ap.add_argument("--steps", type=int, default=10)
    ap.add_argument("--batch", type=int, default=64)
    ap.add_argument("--train", type=int, default=6000)
    ap.add_argument("--data", default=default_data(),
                    help="MNIST location. Defaults to data/ in the repo, else "
                         "the sibling profiler-verification/data")
    ap.add_argument("--download", action="store_true",
                    help="download into --data if missing")
    ap.add_argument("--raw-input", action="store_true")
    ap.add_argument("--out", default="out")
    ap.add_argument("--weights", default="",
                    help="weights directory. Loads files that exist, otherwise trains and saves. "
                         "Use it to measure the same model on different devices")
    ap.add_argument("--device", default="cpu",
                    help="cpu | cuda. On cuda, NVTX labels are emitted too")
    ap.add_argument("--no-torch-profiler", action="store_true",
                    help="measure with hooks only, without PyTorch Profiler. Modules that "
                         "launch many ops accumulate per-op profiler cost, so turn it off "
                         "when looking at per-layer time or wrapping with nsys")
    ap.add_argument("--sync-regions", action="store_true",
                    help="GPU: sync at every region boundary to time each layer's real GPU "
                         "time. Overlap between layers disappears, so the total exceeds run time")
    ap.add_argument("--cover-leaves", action="store_true",
                    help="instrument every module without children")
    ap.add_argument("--no-membrane", action="store_true",
                    help="do not compute the membrane distribution. Each neuron module "
                         "call adds two histogram kernels, so turn it off when "
                         "comparing instrumentation cost")
    ap.add_argument("--no-full-trace", action="store_true",
                    help="do not overlay the full-run op hierarchy. What ran outside "
                         "registered regions is dropped and the file gets smaller")
    ap.add_argument("--nsys", action="store_true",
                    help="wrap the measurement in nsys profile and merge the report into "
                         "regions afterwards. One command. Single model only")
    ap.add_argument("--ncu", action="store_true",
                    help="wrap the measurement in Nsight Compute and merge per-kernel "
                         "counters into regions afterwards. Kernels are replayed with "
                         "clocks locked, so durations are not normal-run timings. "
                         "Single model only; implies --no-torch-profiler")
    ap.add_argument("--with-stack", action="store_true",
                    help="record Python call stacks too. The full-run track grows from "
                         "6 to 20+ levels and the file grows 3-4x. "
                         "Instrumentation cost rises too, so leave off when timing")
    ap.add_argument("--no-op-tree", action="store_true",
                    help="do not emit the operator call hierarchy inside regions. "
                         "Without nested slices the flame graph cannot be drawn")
    ap.add_argument("--perf", type=int, default=0, metavar="N",
                    help="count N forwards (hooks and profiler detached) with perf stat. "
                         "Values are process-wide and not attributed to layers. Linux only, "
                         "needs kernel.perf_event_paranoid<=2")
    args = ap.parse_args()

    if args.nsys and args.ncu:
        print("--nsys and --ncu cannot be combined: ncu replays and serializes kernels, "
              "which would distort the nsys timeline", file=sys.stderr)
        return 1
    for tool in ("nsys", "ncu"):
        if getattr(args, tool) and not os.environ.get(REENTRY):
            return run_wrapped(args, sys.argv[1:], tool)

    names = sorted(REGISTRY) if args.model == "all" else [args.model]
    dev = args.device
    if dev.startswith("cuda") and not torch.cuda.is_available():
        print("CUDA is not available; check nvidia-smi and torch.version.cuda",
              file=sys.stderr)
        return 1
    if dev == "cpu":
        torch.set_num_threads(1)

    for name in names:
        torch.manual_seed(0)
        model, fkw = build(name, num_steps=args.steps)
        model = model.to(dev)

        def train_once():
            opt = torch.optim.Adam(model.parameters(), lr=1e-3)
            lossf = nn.CrossEntropyLoss()
            model.train()
            for xb, yb in mnist(args.batch, args.train, True, args.data,
                                args.raw_input, args.download):
                xb, yb = xb.to(dev), yb.to(dev)
                opt.zero_grad()
                lossf(model(xb, **fkw), yb).backward()
                opt.step()

        origin, digest = load_or_train(
            model, name, args.weights, dev,
            train_once if args.train else None)
        xb, yb = next(iter(mnist(args.batch, args.batch, False, args.data,
                                 args.raw_input, args.download)))
        xb, yb = xb.to(dev), yb.to(dev)
        out_dir = os.path.join(args.out, name)
        trace = profile(model, xb, model_id=name, timesteps=args.steps,
                        batch=args.batch, out_dir=out_dir, device=dev,
                        cover_leaves=args.cover_leaves,
                        sync_regions=args.sync_regions,
                        membrane=not args.no_membrane,
                        op_tree=not args.no_op_tree,
                        full_trace=not args.no_full_trace,
                        with_stack=args.with_stack, perf_reps=args.perf,
                        with_torch_profiler=not args.no_torch_profiler, **fkw)
        trace.env["weights"] = origin
        trace.env["weights_sha256"] = digest
        model.eval()
        with torch.no_grad():
            acc = (model(xb, **fkw).argmax(1) == yb).float().mean().item()
        trace.env["batch_accuracy"] = round(acc, 4)
        trace_json.write(trace, os.path.join(out_dir, "xnn-trace.json"),
                         full=getattr(trace, "_full", None))
        print("=" * 76)
        print(summary(trace))
        print(f"\n-> {out_dir}/xnn-trace.json  "
              f"(device {dev}, weights {origin} {digest[:12]}, batch accuracy {acc:.1%})")
        print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
