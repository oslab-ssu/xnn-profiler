#!/usr/bin/env python3
"""ncu_merge: merge per-kernel Nsight Compute counters into regions.

The report is written after the process exits, so merging is a second step. `--ncu`
on tools/xnnprof does both; this is the manual form.

  1) ncu --nvtx --nvtx-include "regex:.*@t[0-9]+/" --metrics <see xnnprof/collect/ncu.py> \\
         -f -o out/fcsnn/ncu python tools/xnnprof --model fcsnn --device cuda \\
         --train 0 --weights weights --no-torch-profiler
  2) tools/ncu_merge out/fcsnn/xnn-trace.json out/fcsnn/ncu.ncu-rep

Step 2 updates the trace in place; each region gets `args.ncu`.
"""

from __future__ import annotations

import argparse
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO)

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")

from xnnprof.collect.ncu import NcuCollector        # noqa: E402
from xnnprof.emit import trace_json                 # noqa: E402
from xnnprof.emit.full_trace import extract         # noqa: E402
from xnnprof.schema import Trace                    # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("trace", help="xnn-trace.json")
    ap.add_argument("report", help=".ncu-rep")
    ap.add_argument("--out", default="", help="defaults to updating the input trace in place")
    ap.add_argument("--top", type=int, default=3, help="top kernels per region")
    args = ap.parse_args()

    trace = Trace.load(args.trace)
    full = extract(args.trace)
    src = NcuCollector(args.report, top=args.top).collect(trace)
    trace.sources = [s for s in trace.sources if s.collector != src.collector]
    trace.sources.append(src)
    out = args.out or args.trace
    trace_json.write(trace, out, full=full)

    d = src.detail or {}
    print(f"nsight_compute  {src.status}  {src.reason}")
    if d:
        print(f"  {d.get('kernels_profiled')} kernels, {d.get('nvtx_ranges')} NVTX ranges -> "
              f"{d.get('matched_regions')} of {len(trace.regions)} regions, "
              f"clock {(d.get('clock_hz') or 0) / 1e9:.3f} GHz ({d.get('clock_control')})")
    top = sorted((r for r in trace.regions if r.ncu),
                 key=lambda r: -r.ncu.get("kernel_us", 0))[:8]
    if top:
        print(f"\n  {'region':16s} {'kernels':>7s} {'kernel(us)':>10s} {'MFLOP':>9s} "
              f"{'DRAM(KB)':>9s} {'FLOP/B':>7s} {'SM%':>6s} {'occ%':>6s}")
        for r in top:
            g = r.ncu
            nb = g.get("dram_read_bytes", 0) + g.get("dram_write_bytes", 0)
            ai = g.get("flops_per_dram_byte")
            print(f"  {r.layer_id + '@t' + str(r.timestep):16s} {g['kernels']:7d} "
                  f"{g['kernel_us']:10,.1f} {g['flops_fp32'] / 1e6:9.2f} {nb / 1024:9.1f} "
                  f"{ai if ai is not None else float('nan'):7.2f} "
                  f"{g.get('sm_throughput_pct', float('nan')):6.1f} "
                  f"{g.get('achieved_occupancy_pct', float('nan')):6.1f}")
    print(f"\n-> {out}")
    return 0 if src.status in ("captured", "partial") else 1


if __name__ == "__main__":
    raise SystemExit(main())
