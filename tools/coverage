#!/usr/bin/env python3
"""Instrumentation coverage -- how much time goes unattributed under each
registration rule.

Hooks are registered by walking the model tree, so operations that do not
appear in the tree as a module, and operations of modules excluded from
registration, belong to no region. That share is measured so the two rules can
be compared.

  mac+neuron     modules that perform MACs + SNN neuron modules (current rule)
  leaf-modules   every module without children (including ReLU, MaxPool2d,
                 Flatten)

  tools/coverage --steps 10 --batch 64
"""

from __future__ import annotations

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

# When stdout is a pipe, Windows falls back to cp949 and non-ASCII symbols
# raise UnicodeEncodeError (this happens under `nsys profile`). Pin UTF-8.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")


from xnnprof.collect.torch_hooks import TorchHookCollector   # noqa: E402
from xnnprof.collect.torch_prof import TorchProfilerCollector  # noqa: E402
from xnnprof.models import REGISTRY, build                   # noqa: E402
from xnnprof.schema import Trace                             # noqa: E402


def measure(name: str, steps: int, batch: int, leaves: bool, memory: bool) -> dict:
    import torch
    from torch.profiler import ProfilerActivity, profile as tprofile

    torch.manual_seed(0)
    model, fkw = build(name, num_steps=steps)
    model.eval()
    x = torch.rand(batch, 1, 28, 28)
    with torch.no_grad():
        model(x, **fkw)                              # warm-up: skip lazy init

    trace = Trace(run_id="coverage", model_id=name, timesteps=steps, batch=batch)
    c = TorchHookCollector(cover_leaves=leaves)
    c.attach(model)
    with tprofile(activities=[ProfilerActivity.CPU], profile_memory=memory) as prof:
        with torch.no_grad():
            model(x, **fkw)
    c.detach()
    c.collect(trace)
    s = TorchProfilerCollector(prof).collect(trace)
    d = dict(s.detail)
    d["regions"] = len(trace.regions)
    d["layers"] = len(trace.layers)
    return d


def main() -> int:
    import torch

    ap = argparse.ArgumentParser()
    ap.add_argument("--model", default="all", choices=sorted(REGISTRY) + ["all"])
    ap.add_argument("--steps", type=int, default=10)
    ap.add_argument("--batch", type=int, default=64)
    ap.add_argument("--repeat", type=int, default=3)
    ap.add_argument("--profile-memory", action="store_true")
    args = ap.parse_args()

    torch.set_num_threads(1)
    names = sorted(REGISTRY) if args.model == "all" else [args.model]

    print(f"batch={args.batch}  T={args.steps}  repeat={args.repeat}"
          f"  profile_memory={args.profile_memory}")
    print(f"{'model':18s} {'rule':14s} {'layers':>7s} {'regions':>8s} "
          f"{'attr.rate(med)':>15s} {'unattr.(us)':>12s} {'instr.(us)':>11s}")
    for name in names:
        for leaves in (False, True):
            runs = [measure(name, args.steps, args.batch, leaves, args.profile_memory)
                    for _ in range(args.repeat)]
            runs.sort(key=lambda d: d["attribution_rate"])
            mid = runs[len(runs) // 2]
            tag = "leaf-modules" if leaves else "mac+neuron"
            print(f"{name:18s} {tag:14s} {mid['layers']:7d} {mid['regions']:8d} "
                  f"{mid['attribution_rate']:15.1%} {mid['unattributed_us']:12,.0f} "
                  f"{mid['instrument_us']:11,.0f}")
            for o in (mid.get("unattributed_top") or [])[:3]:
                print(f"{'':33s} unattributed {o['op']:32s} "
                      f"{o['self_time_us']:>10,.1f}us")
        print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
